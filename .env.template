# ===========================================
# Environment Variables Template
# Copy this file to .env and fill in the values
# ===========================================

# PostgreSQL Database
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=app_db
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# Database URL (for FastAPI/SQLAlchemy)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/app_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Redis URL (for connection pooling)
REDIS_URL=redis://redis:6379/0

# Flower Monitoring (optional)
FLOWER_PORT=5555
# FLOWER_BASIC_AUTH=admin:password  # Uncomment to enable basic auth

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
# DEBUG=true  # Uncomment for debug mode

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
